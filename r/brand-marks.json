53.387V82.3H440.488Z\" />\n      <path d=\"M411.871 82.31V40.0169H419.766V82.31H411.871ZM415.818 34.2369C414.503 34.2369 413.375 33.7669 412.435 32.8271C411.495 31.8872 411.025 30.7594 411.025 29.4436C411.025 28.1279 411.495 27 412.435 26.0602C413.375 25.1204 414.503 24.6504 415.818 24.6504C417.134 24.6504 418.262 25.1204 419.202 26.0602C420.142 27 420.612 28.1279 420.612 29.4436C420.612 30.7594 420.142 31.8872 419.202 32.8271C418.262 33.7669 417.134 34.2369 415.818 34.2369Z\" />\n      <path d=\"M393.412 82.2982V23.0879H401.307V82.2982H393.412Z\" />\n      <path d=\"M343.801 99.2132V48.1796H339.712V40.0029H348.171V46.4879H351.132C352.541 44.0913 354.468 42.2821 356.912 41.0603C359.355 39.7915 362.269 39.1571 365.652 39.1571C369.929 39.1571 373.547 40.0499 376.507 41.8356C379.468 43.6213 381.724 46.1589 383.274 49.4484C384.872 52.7378 385.671 56.6382 385.671 61.1495C385.671 65.6607 384.896 69.5611 383.345 72.8505C381.794 76.14 379.562 78.6776 376.648 80.4633C373.782 82.249 370.351 83.1418 366.357 83.1418C363.021 83.1418 360.107 82.484 357.617 81.1682C355.126 79.8054 353.246 77.9022 351.977 75.4586H351.695V99.2132H343.801ZM364.454 76.375C368.683 76.375 371.949 75.0357 374.252 72.3571C376.601 69.6786 377.776 65.9427 377.776 61.1495C377.776 56.3562 376.601 52.6204 374.252 49.9418C371.949 47.2632 368.683 45.924 364.454 45.924C360.601 45.924 357.499 47.0283 355.149 49.2369C352.847 51.4455 351.695 54.3826 351.695 58.048V64.2509C351.695 67.9163 352.847 70.8534 355.149 73.062C357.499 75.2706 360.601 76.375 364.454 76.375Z\" />\n      <path d=\"M312.928 83.1419C308.558 83.1419 304.728 82.249 301.438 80.4633C298.196 78.6306 295.682 76.0695 293.896 72.7801C292.11 69.4906 291.218 65.6137 291.218 61.1495C291.218 56.6852 292.11 52.8083 293.896 49.5189C295.682 46.2294 298.196 43.6918 301.438 41.9061C304.728 40.0734 308.558 39.1571 312.928 39.1571C317.439 39.1571 321.293 40.0499 324.488 41.8356C327.731 43.6213 330.221 46.1589 331.96 49.4484C333.746 52.7378 334.638 56.6382 334.638 61.1495C334.638 65.6137 333.746 69.5141 331.96 72.8505C330.221 76.14 327.731 78.6776 324.488 80.4633C321.246 82.249 317.392 83.1419 312.928 83.1419ZM312.928 76.234C317.298 76.234 320.682 74.9182 323.078 72.2866C325.522 69.6081 326.744 65.8957 326.744 61.1495C326.744 56.3562 325.522 52.6439 323.078 50.0123C320.682 47.3807 317.298 46.0649 312.928 46.0649C308.605 46.0649 305.221 47.4042 302.778 50.0828C300.334 52.7143 299.112 56.4032 299.112 61.1495C299.112 65.8957 300.334 69.6081 302.778 72.2866C305.221 74.9182 308.605 76.234 312.928 76.234Z\" />\n      <path d=\"M233.535 82.2988V25.2031H241.641V49.2397H274.489V25.2031H282.595V82.2988H274.489V56.1476H241.641V82.2988H233.535Z\" />\n    </svg>\n  );\n}\n\n/** The horse mark alone, in the current color. */\nfunction Mark({ className }: { className?: string }) {\n  return (\n    <svg viewBox=\"0 0 202.3 104\" aria-hidden fill=\"currentColor\" className={cn(\"h-6 w-auto\", className)}>\n      <path d=\"M201.038 104H191.906C191.209 104 190.644 103.429 190.644 102.725V98.9303C190.644 98.4595 190.387 98.0269 189.976 97.8055L173.656 89.0162C172.794 88.5521 172.758 87.318 173.591 86.8036L182.18 81.5032C182.696 81.1846 183.363 81.2805 183.771 81.7312L201.971 101.866C202.71 102.684 202.135 104 201.038 104Z\" />\n      <path d=\"M164 72.489L155.157 72.2665H65.3014C65.0776 72.2665 64.8578 72.3268 64.6645 72.4408L24.622 96.0664L17.9354 99.6734C17.5244 99.8947 17.2678 100.327 17.2678 100.797V102.715C17.2678 103.423 16.6965 103.995 15.9954 103.99L2.777 103.885C1.69319 103.877 1.12322 102.584 1.84219 101.765L31.4788 68.0049C31.539 67.9358 31.5917 67.8607 31.636 67.7809L35.6339 60.5578C36.2604 59.4259 35.0082 58.1822 33.8978 58.8334L23.8073 64.7519C16.1035 69.2705 6.23674 66.7577 1.57636 59.0902L0.186511 56.8036C0.0645552 56.603 0 56.3721 0 56.1367V39.1349C0 37.8338 1.7033 37.3685 2.35283 38.4922L6.95259 46.4501C10.4469 52.4953 18.1142 54.565 24.1295 51.0869L39.0919 42.4351C39.4819 42.2097 39.7238 41.7918 39.7271 41.3381L39.7611 36.6295C39.7682 35.6483 38.7207 35.0271 37.8755 35.5115L22.456 44.3488C19.2191 46.2039 15.1035 44.8429 13.5805 41.4136L0.110566 11.0854C0.0376803 10.9213 4.99427e-06 10.7435 1.46546e-05 10.5636L0.000509456 1.35161C0.00054544 0.681659 0.538382 0.138575 1.20182 0.138575C11.8406 0.138575 22.4381 1.47556 32.7499 4.11871L47.0051 7.77265C47.803 7.97721 48.5782 7.3683 48.5782 6.53697V1.06967C48.5782 0.555442 48.991 0.138575 49.5003 0.138575C58.4943 0.138575 67.2631 2.98015 74.5776 8.26507L91.0025 20.1324C91.2163 20.2872 91.4734 20.3704 91.7371 20.3704H107.266C107.963 20.3704 108.529 19.7997 108.529 19.0956V17.1416C108.529 16.4375 107.963 15.8668 107.266 15.8668H91.9516C90.683 15.8668 90.2068 14.1887 91.2834 13.5104L101.001 7.38614C108.66 2.55912 117.507 0 126.536 0C134.975 0 143.267 2.23636 150.582 6.48565L153.501 8.1807C154.318 8.65528 154.35 9.83394 153.561 10.3538L140.813 18.746C140.456 18.9814 140.24 19.3831 140.24 19.814V24.134C140.24 24.5841 140.005 25.0009 139.622 25.2305L135.378 27.7719C134.251 28.4472 132.977 27.1539 133.651 26.0189L134.214 25.0733C134.719 24.2235 134.114 23.1419 133.132 23.1419H127.733C126.383 23.1419 125.975 24.9937 127.198 25.5715L131.719 27.7079C132.626 28.1364 132.701 29.4095 131.852 29.9444L123.626 35.1239C123.425 35.2501 123.194 35.3169 122.958 35.3169H119.295C118.608 35.3169 118.051 35.8797 118.051 36.5739C118.051 37.268 118.608 37.8308 119.295 37.8308H126.055C126.283 37.8308 126.505 37.769 126.7 37.652L177.774 7.01317C183.784 3.4082 191.473 4.54749 196.203 9.74387C196.299 9.8495 196.352 9.98766 196.352 10.1311V13.9548C196.352 15.0616 197.653 15.6427 198.464 14.8982L201.788 11.8467C202.6 11.1021 203.9 11.6832 203.9 12.79V54.917C203.9 55.6211 203.335 56.1919 202.637 56.1919H196.945C196.57 56.1919 196.214 56.0229 195.974 55.7309L183.974 41.1205C183.48 40.5198 182.573 40.5038 182.059 41.0867L172.053 52.4357C171.539 53.019 171.66 53.928 172.309 54.353L174 55.461Z\" />\n      <path d=\"M174 55.461L192.719 67.7219C193.506 68.237 193.481 69.4087 192.673 69.8896L160.874 88.8123C160.057 89.2979 159.022 88.7365 158.972 87.7808L158.521 79.1095C158.482 78.3798 159.058 77.7674 159.781 77.7674H164.914C165.223 77.7674 165.522 77.6528 165.753 77.4455L168.684 74.8144C169.54 74.0465 169.022 72.6159 167.877 72.5871L164 72.489L157 68L166 58L171.6 54.9Z\" />\n      <path d=\"M91.233 76.2161H73.835C73.6106 76.2161 73.39 76.2765 73.1968 76.3912L53.1964 88.2315C52.322 88.7493 52.3777 90.0437 53.2933 90.483L71.2488 99.0946C71.6891 99.3059 71.9701 99.7539 71.9701 100.246V102.725C71.9701 103.429 72.5353 104 73.2326 104H83.8427C84.938 104 85.5138 102.688 84.7779 101.869L74.6706 90.6091C74.1333 90.0108 74.2754 89.0651 74.9648 88.6547L91.8739 78.589C92.9817 77.9297 92.5181 76.2161 91.233 76.2161Z\" />\n    </svg>\n  );\n}\n\nconst HEX = \"M22 12L17 20.66L7 20.66L2 12L7 3.34L17 3.34Z\";\nconst HOLE = \"M16.2 12L14.1 15.64L9.9 15.64L7.8 12L9.9 8.36L14.1 8.36Z\";\n\n/** The cog node. `active` is the orange node with its hexagon hole; otherwise an outline of the strong edge. */\nfunction HexNode({ active = false, dashed = false, className, ...props }: React.ComponentProps<\"svg\"> & { active?: boolean; dashed?: boolean }) {\n  return (\n    <svg data-slot=\"hex-node\" data-active={active || undefined} viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden className={cn(\"size-6 shrink-0\", className)} {...props}>\n      {active ? (\n        <>\n          <path d={HEX} className=\"fill-brand\" />\n          <path d={HOLE} className=\"fill-surface\" />\n        </>\n      ) : (\n        <path d={HEX} className=\"fill-surface stroke-line-strong\" strokeWidth={1} strokeDasharray={dashed ? \"2 2\" : undefined} />\n      )}\n    </svg>\n  );\n}\n\n/** A plan's row of nodes over a dashed rule: `count` nodes, `active` of them orange, `ghost` more drawn dashed. */\nfunction NodeCluster({ count = 1, active = 1, ghost = 0, className }: { count?: number; active?: number; ghost?: number; className?: string }) {\n  return (\n    <div data-slot=\"node-cluster\" aria-hidden className={cn(\"ds-rule-x flex items-end pb-1\", className)}>\n      {Array.from({ length: count + ghost }, (_, i) => (\n        <HexNode key={i} active={i < active} dashed={i >= count} className={cn(\"size-5 bg-surface\", i % 2 === 1 && \"-mb-2\", i > 0 && \"-ml-1\")} />\n      ))}\n    </div>\n  );\n}\n\ntype Leaf = { title: string; note?: string; active?: boolean };\n\n/** The blog's branch diagram: a root node with its label, and leaves on square elbows, each a title over a mono note. */\nfunction NodeTree({ root, rootNote, leaves, className }: { root?: string; rootNote?: string; leaves: Leaf[]; className?: string }) {\n  return (\n    <div data-slot=\"node-tree\" aria-hidden className={cn(\"flex items-center\", className)}>\n      <div className=\"flex max-w-32 shrink-0 flex-col items-center self-stretch text-center\">\n        <span className=\"flex-1\" />\n        <HexNode active />\n        <span className=\"flex flex-1 flex-col items-center pt-1\">\n          {root && <span className=\"font-sans text-body-sm leading-line-body-sm text-balance text-fg\">{root}</span>}\n          {rootNote && <span className=\"font-code text-caption leading-line-caption tracking-code text-fg-muted\">{rootNote}</span>}\n        </span>\n      </div>\n      <span className=\"h-px w-4 shrink-0 bg-line-strong sm:w-8\" />\n      <ul className=\"m-0 grid min-w-0 list-none p-0\">\n        {leaves.map((leaf) => (\n          <li key={leaf.title} className=\"relative flex items-center gap-2 py-2 before:absolute before:top-0 before:bottom-0 before:left-0 before:w-px before:bg-line-strong first:before:top-1/2 last:before:bottom-1/2\">\n            <span className=\"h-px w-3 shrink-0 bg-line-strong sm:w-5\" />\n            <HexNode active={leaf.active} className=\"size-5\" />\n            <span className=\"grid min-w-0\">\n              <span className=\"font-sans text-body-sm leading-line-body-sm text-fg\">{leaf.title}</span>\n              {leaf.note && <span className=\"font-code text-caption leading-line-caption tracking-code text-fg-muted\">{leaf.note}</span>}\n            </span>\n          </li>\n        ))}\n      </ul>\n    </div>\n  );\n}\n\nexport { HexNode, Lockup, Mark, NodeCluster, NodeTree, type Leaf };\n"
    }
  ]
}
