      "path": "components/site/brand-marks.tsx",
      "content": "import * as React from \"react\";\n\nimport { cn } from \"@/lib/utils\";\n\n// The brand marks the section blocks and page templates draw with. Lockup is the website header's lockup\n// (.site-header__logo): the horse mark and the wordmark, 24px tall, in the current color. Mark is the horse alone.\n// HexNode is the site's cog node (the plan marks on the pricing page, the nodes on the blog's diagrams): a\n// hexagon, points left and right, drawn as a 1px outline of the strong edge, or filled orange with a hexagon cut from\n// its middle when it is the one that matters. NodeCluster is the pricing page's row of nodes over a dashed rule;\n// NodeTree is the blog's branch diagram: a root node and labeled leaves on square elbows.\nfunction Lockup({ className, label = \"Hoplite\" }: { className?: string; label?: string }) {\n  return (\n    <svg viewBox=\"0 0 498.024 104\" role=\"img\" aria-label={label} fill=\"currentColor\" className={cn(\"h-6 w-auto text-fg\", className)}>\n      <path d=\"M201.038 104H191.906C191.209 104 190.644 103.429 190.644 102.725V98.9303C190.644 98.4595 190.387 98.0269 189.976 97.8055L173.656 89.0162C172.794 88.5521 172.758 87.318 173.591 86.8036L182.18 81.5032C182.696 81.1846 183.363 81.2805 183.771 81.7312L201.971 101.866C202.71 102.684 202.135 104 201.038 104Z\" />\n      <path d=\"M164 72.489L155.157 72.2665H65.3014C65.0776 72.2665 64.8578 72.3268 64.6645 72.4408L24.622 96.0664L17.9354 99.6734C17.5244 99.8947 17.2678 100.327 17.2678 100.797V102.715C17.2678 103.423 16.6965 103.995 15.9954 103.99L2.777 103.885C1.69319 103.877 1.12322 102.584 1.84219 101.765L31.4788 68.0049C31.539 67.9358 31.5917 67.8607 31.636 67.7809L35.6339 60.5578C36.2604 59.4259 35.0082 58.1822 33.8978 58.8334L23.8073 64.7519C16.1035 69.2705 6.23674 66.7577 1.57636 59.0902L0.186511 56.8036C0.0645552 56.603 0 56.3721 0 56.1367V39.1349C0 37.8338 1.7033 37.3685 2.35283 38.4922L6.95259 46.4501C10.4469 52.4953 18.1142 54.565 24.1295 51.0869L39.0919 42.4351C39.