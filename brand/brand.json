{
	"name": "Hoplite",
	"bin": "hoplite-ds",
	"source": "github:anwarlemu/hoplite-brand-cli#release",
	"reviewModel": "claude-opus-5-5",
	"reviewThreshold": 7,
	"registryUrl": "https://hoplite-ds.vercel.app",
	"site": "https://hoplite.sh",
	"surfaces": [
		"site"
	],
	"fonts": {
		"css": "https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@300;400&family=Kode+Mono:wght@400&display=swap",
		"always": [
			"https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500&display=swap"
		],
		"next": [
			{
				"import": "Chakra_Petch",
				"variable": "--font-chakra-petch",
				"options": {
					"display": "swap",
					"weight": [
						"300",
						"400"
					]
				}
			},
			{
				"import": "Kode_Mono",
				"variable": "--font-kode-mono",
				"options": {
					"display": "swap",
					"weight": [
						"400"
					]
				}
			}
		],
		"native": "Add Chakra Petch (light and regular, display and headings), Satoshi (light, regular and medium, all other text) and Kode Mono (labels and code) to the app as fonts and set them on its text styles"
	},
	"icons": {
		"name": "Phosphor",
		"packages": [
			"@phosphor-icons/react",
			"phosphor-react-native"
		]
	},
	"touches": {},
	"type": {
		"caps": true,
		"bold": false
	},
	"variants": {
		"site": {
			"filled": "default",
			"outlined": "outline",
			"quiet": "ghost",
			"onBrand": "secondary",
			"card": "default",
			"size": "default",
			"badges": {
				"brand": "default",
				"success": "success",
				"warning": "gray",
				"destructive": "destructive",
				"tag": "blue",
				"chip": "outline"
			}
		}
	}
}
